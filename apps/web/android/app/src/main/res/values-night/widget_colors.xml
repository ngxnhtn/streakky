<!-- The widget's default look, in the teal palette: the widget list's preview (Morning run, in
     green) and a widget before the app has written its own look, which the app measures from
     its stylesheet (apps/web/src/widget-look.ts). A habit's tile is its colour at
     16% over the dark ground. Copied from packages/ui/src/styles/globals.css; keep the two in step. -->
<resources>
    <color name="widget_ground">#06525C</color>
    <color name="widget_name">#F7F9F8</color>
    <color name="widget_label">#C1D0D2</color>
    <color name="habit_teal">#F7F9F8</color>
    <color name="habit_teal_tile">#2D6D75</color>
    <color name="habit_green">#B4DEA0</color>
    <color name="habit_green_tile">#226867</color>
</resources>
