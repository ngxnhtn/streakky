<?xml version="1.0" encoding="utf-8"?>
<!-- Streakky's mark, the open ring of the web app's icon (scripts/render-icons.ts), on an adaptive
     icon's 108dp canvas: the 24-unit ring at 1.8 times, a little below centre since it's open at
     the bottom, well inside the 66dp every launcher shape keeps. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.8"
        android:scaleY="1.8"
        android:translateX="42"
        android:translateY="43.2">
        <path
            android:pathData="M5.64,18.36A9,9 0,1 1,18.36 18.36"
            android:strokeColor="#F7F9F8"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
    </group>
</vector>
