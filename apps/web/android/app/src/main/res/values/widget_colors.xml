<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's default look, in the teal palette: the widget list's preview (Morning run, in
     green) and a widget before the app has written its own look, which the app measures from
     its stylesheet (apps/web/src/widget-look.ts). A habit's tile is its colour at
     9% over the light ground. Copied from packages/ui/src/styles/globals.css; keep the two in step. -->
<resources>
    <color name="widget_ground">#F7F9F8</color>
    <color name="widget_name">#06525C</color>
    <color name="widget_label">#2F737D</color>
    <color name="habit_teal">#06525C</color>
    <color name="habit_teal_tile">#E1EAEA</color>
    <color name="habit_green">#2F6B2A</color>
    <color name="habit_green_tile">#E5ECE5</color>
</resources>
